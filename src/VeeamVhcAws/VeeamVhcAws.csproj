<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VeeamVhcAws</RootNamespace>
    <AssemblyName>veeam-vhc-aws</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Veeam VHC AWS Monitor</Product>
    <Company>VeeamHub</Company>
    <FileDescription>Veeam Health Check monitor for AWS workloads</FileDescription>
    <Copyright>Copyright © VeeamHub 2025-2026</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!-- Suppress IL trim warnings: reflection intentionally re-enabled via JsonSerializerIsReflectionEnabledByDefault -->
    <NoWarn>$(NoWarn);IL2026;IL3000;IL2104</NoWarn>
  </PropertyGroup>

  <!-- Suppress .pdb in release builds so the publish output is a single clean exe -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- Publish-time settings (Release only — debug runs should not be trimmed) -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- IL trimming is intentionally DISABLED. The Blazor admin UI discovers its
         routable page components via reflection (Routes.razor <Router AppAssembly=...>),
         so the trimmer strips the @page components and the "/" endpoint never registers
         (root page returns 404 while minimal-API endpoints survive). Trimming a Blazor
         Web App is unsupported; keep it off so the GUI routes correctly. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Re-enable JSON reflection: we use Dictionary<string,object> throughout and can't source-generate for it -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Polly" Version="8.5.2" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>VeeamVhcAws.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Web SDK implicit-usings collide with Serilog.ILogger; suppress and import explicitly when needed -->
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config\example.yaml">
      <LogicalName>VeeamVhcAws.config.example.yaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
