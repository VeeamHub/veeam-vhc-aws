@code {
    [Parameter, EditorRequired] public ServerEdit Model { get; set; } = new("", "vbr", "", "", "", false, false, "1.3-rev1");
    [Parameter] public EventCallback<ServerEdit> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsNew { get; set; }

    private string _name = "";
    private string _type = "vbr";
    private string _url = "";
    private string _username = "";
    private string _password = "";
    private bool _passwordChanged;
    private bool _verifySsl;
    private string _apiVersion = "1.3-rev1";
    private string? _error;
    private string _lastAutoUrl = "";

    protected override void OnParametersSet()
    {
        _name = Model.Name;
        _type = Model.Type;
        _url = Model.Url;
        _username = Model.Username;
        _password = IsNew ? "" : "********";
        _passwordChanged = IsNew;
        _verifySsl = Model.VerifySsl;
        _apiVersion = string.IsNullOrEmpty(Model.ApiVersion) ? "1.3-rev1" : Model.ApiVersion;
    }

    private void OnPasswordInput(ChangeEventArgs e)
    {
        _password = e.Value?.ToString() ?? "";
        _passwordChanged = true;
    }

    // Issue #13: auto-fill the URL from the Name as a convenience, but only while the user
    // hasn't hand-edited the URL (tracked via _lastAutoUrl).
    private void OnNameInput(ChangeEventArgs e)
    {
        _name = e.Value?.ToString() ?? "";
        var suggested = ServerFormHelpers.SuggestUrl(_name, _url, _lastAutoUrl);
        if (suggested != _url)
        {
            _url = suggested;
            _lastAutoUrl = suggested;
        }
    }

    private async Task Save()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required"; return; }
        if (string.IsNullOrWhiteSpace(_url))  { _error = "URL is required"; return; }
        if (!Uri.TryCreate(_url, UriKind.Absolute, out _)) { _error = "URL must be an absolute URL (e.g. https://host:9419)"; return; }
        if (string.IsNullOrWhiteSpace(_username)) { _error = "Username is required"; return; }

        var edit = new ServerEdit(
            Name: _name.Trim(),
            Type: _type,
            Url: _url.Trim(),
            Username: _username.Trim(),
            Password: _passwordChanged ? _password : "",
            PasswordChanged: _passwordChanged,
            VerifySsl: _verifySsl,
            ApiVersion: _type == "vbr" ? _apiVersion : "");

        await OnSave.InvokeAsync(edit);
    }
}

<div class="modal-overlay" @onclick="OnCancel">
    <div class="modal" @onclick:stopPropagation="true">
        <h2>@(IsNew ? "Add Server" : $"Edit {Model.Name}")</h2>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="form-error">@_error</div>
        }

        <div class="form-row">
            <label>Name <span class="muted">(unique label)</span></label>
            <input type="text" value="@_name" @oninput="OnNameInput" placeholder="e.g. prod-vbr" disabled="@(!IsNew)" />
        </div>

        <div class="form-row">
            <label>Type</label>
            <div class="radio-group">
                <label><input type="radio" name="type" value="vbr" checked="@(_type == "vbr")" @onchange="@(() => _type = "vbr")" /> VBR (Veeam Backup &amp; Replication)</label>
                <label><input type="radio" name="type" value="vbaws" checked="@(_type == "vbaws")" @onchange="@(() => _type = "vbaws")" /> VBAWS (Veeam Backup for AWS)</label>
            </div>
        </div>

        <div class="form-row">
            <label>URL</label>
            <input type="text" @bind="_url" @bind:event="oninput" placeholder="https://server:9419" />
        </div>

        <div class="form-row">
            <label>Username</label>
            <input type="text" @bind="_username" @bind:event="oninput" placeholder="DOMAIN\\backupadmin or admin" />
        </div>

        <div class="form-row">
            <label>Password</label>
            <input type="password" value="@_password" @oninput="OnPasswordInput" />
            @if (!IsNew && !_passwordChanged)
            {
                <span class="muted">(unchanged — leave as-is to keep existing)</span>
            }
        </div>

        <div class="form-row">
            <label><input type="checkbox" @bind="_verifySsl" /> Verify SSL certificate</label>
        </div>

        @if (_type == "vbr")
        {
            <div class="form-row">
                <label>API Version</label>
                <select @bind="_apiVersion">
                    <option value="1.3-rev1">1.3-rev1 (VBR 13+)</option>
                    <option value="1.1-rev2">1.1-rev2 (VBR 12.3 and earlier)</option>
                </select>
            </div>
        }

        <div class="form-actions">
            <button class="btn-secondary" @onclick="OnCancel">Cancel</button>
            <button class="btn" @onclick="Save">Save</button>
        </div>
    </div>
</div>
