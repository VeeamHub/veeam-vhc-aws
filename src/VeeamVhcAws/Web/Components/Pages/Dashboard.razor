@page "/"
@rendermode InteractiveServer
@inject StateService State
@inject ConfigService Config
@implements IDisposable

<PageTitle>Dashboard — Veeam VHC AWS</PageTitle>

<h1>Dashboard</h1>
<p class="muted">Overall health of every monitored server. The scheduled task updates it on every run.</p>

@if (_state is null || _cfg is null)
{
    <p>Loading…</p>
}
else
{
    var crit = _state.ActiveFindings.Count(a => a.Severity == "critical");
    var warn = _state.ActiveFindings.Count(a => a.Severity == "warning");
    var err  = _state.ActiveFindings.Count(a => a.Severity == "error");
    var hasRun = _state.LastRun is not null;
    var clear = err == 0 && crit == 0 && warn == 0;
    var pending = !hasRun && clear;

    var serversClass  = "card-neutral";
    var findingsClass = FindingsCardClass(crit, warn, err, hasRun);
    var errorsClass   = ErrorsCardClass(_state.CapturedErrors);
    var lastRunClass  = LastRunCardClass(_state.LastRun);

    var steps = GettingStarted.Evaluate(_cfg, _state);
    var nextIndex = steps.ToList().FindIndex(x => !x.Done);
    if (nextIndex >= 0)
    {
        <section class="card getting-started" aria-labelledby="getting-started-title">
            <div class="getting-started-head">
                <h2 id="getting-started-title">Getting started</h2>
                <a href="help">Read the guide</a>
            </div>
            <ol class="checklist">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var step = steps[i];
                    <li class="@(step.Done ? "done" : i == nextIndex ? "next" : "")">
                        <span class="check" aria-hidden="true">@(step.Done ? "✓" : "○")</span>
                        <div>
                            <strong>@step.Title</strong>@(step.Done ? " (done)" : i == nextIndex ? " (next)" : "")
                            <p class="muted">@step.HowTo <a href="@step.Href">@step.LinkText</a></p>
                        </div>
                    </li>
                }
            </ol>
        </section>
    }

    <section class="status-banner @(pending ? "pending" : clear ? "ok" : "alert")">
        @if (pending)
        {
            <strong>[--]</strong> <span>No runs yet — @_cfg.Servers.Count server(s) configured</span>
        }
        else if (clear)
        {
            <strong>[OK]</strong> <span>All monitors clear — @_cfg.Servers.Count server(s), 0 findings</span>
        }
        else
        {
            <strong>[!!]</strong>
            <span>
                @if (err > 0) { @($"{err} error ") }
                @if (crit > 0) { @($"{crit} critical ") }
                @if (warn > 0) { @($"{warn} warning ") }
                — action required
            </span>
        }
    </section>

    <section class="card-grid">
        <div class="card @serversClass">
            <h3>Servers</h3>
            <p class="big-number">@_cfg.Servers.Count</p>
            <p class="card-sub">@($"{_cfg.Servers.Count(s => s.Type == "vbr")} VBR, {_cfg.Servers.Count(s => s.Type == "vbaws")} VBAWS")</p>
        </div>
        <div class="card @findingsClass">
            <h3>Active Findings</h3>
            <p class="big-number">@_state.ActiveFindings.Count</p>
            <p class="card-sub">@($"{crit} critical, {warn} warning")</p>
        </div>
        <div class="card @errorsClass">
            <h3>Captured Errors</h3>
            <p class="big-number">@_state.CapturedErrors.Count</p>
            <p class="card-sub">@($"{_state.CapturedErrors.Count(a => a.Suppressed)} suppressed")</p>
        </div>
        <div class="card @lastRunClass">
            <h3>Last Run</h3>
            <p class="big-number">@(_state.LastRun?.ToLocalTime().ToString("HH:mm") ?? "—")</p>
            <p class="card-sub">@(_state.LastRun?.ToLocalTime().ToString("yyyy-MM-dd") ?? "no runs yet")</p>
        </div>
    </section>

    <section>
        <h2>Servers</h2>
        @if (_cfg.Servers.Count == 0)
        {
            <p>No servers configured. <a href="servers">Add a server</a> to begin.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th>Name</th><th>Type</th><th>URL</th><th>Last successful run</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _cfg.Servers)
                    {
                        var lastVbr = _state.LastSuccessByKey.GetValueOrDefault($"{s.Name}:repo_health");
                        var lastVbaws = _state.LastSuccessByKey.GetValueOrDefault($"{s.Name}:worker_health");
                        var last = s.Type == "vbr" ? lastVbr : lastVbaws;
                        <tr>
                            <td><strong>@s.Name</strong></td>
                            <td>@s.Type.ToUpperInvariant()</td>
                            <td>@s.Url</td>
                            <td>@(last == default ? "—" : last.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private StateSnapshot? _state;
    private ConfigSnapshot? _cfg;
    private System.Threading.Timer? _autoRefresh;

    protected override void OnInitialized()
    {
        Refresh();
        _autoRefresh = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private void Refresh()
    {
        _state = State.Load();
        _cfg = Config.Load();
    }

    public void Dispose() => _autoRefresh?.Dispose();

    private static string FindingsCardClass(int crit, int warn, int err, bool hasRun)
    {
        if (crit > 0) return "card-crit";
        if (warn > 0 || err > 0) return "card-warn";
        return hasRun ? "card-ok" : "card-neutral";
    }

    private static string ErrorsCardClass(IReadOnlyList<AlertView> errors)
    {
        if (errors.Count == 0) return "card-neutral";
        return errors.Any(a => !a.Suppressed) ? "card-warn" : "card-ok";
    }

    private static string LastRunCardClass(DateTime? lastRun)
    {
        if (lastRun is null) return "card-neutral";
        return (DateTime.UtcNow - lastRun.Value).TotalHours > 1 ? "card-warn" : "card-ok";
    }
}
