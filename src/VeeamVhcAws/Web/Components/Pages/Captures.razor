@page "/captures"
@rendermode InteractiveServer
@inject StateService State

<PageTitle>Captures — Veeam VHC AWS</PageTitle>

<h1>Captured Errors</h1>
<p class="muted">History of every problem the monitors have reported, including cleared ones. Use it to spot something that keeps coming back.</p>

<div class="toolbar">
    <label for="captures-filter">Show:
        <select id="captures-filter" @bind="Filter">
            <option value="all">All</option>
            <option value="unsuppressed">Unsuppressed only</option>
            <option value="suppressed">Suppressed only</option>
        </select>
    </label>
    <button type="button" class="btn" @onclick="Refresh">Refresh</button>
</div>

@if (_snapshot is null)
{
    <p>Loading…</p>
}
else if (_snapshot.CapturedErrors.Count == 0)
{
    <p class="empty">No captured errors yet.</p>
}
else if (_filtered.Count == 0)
{
    <p class="empty">No captured errors match the current filter.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Key</th>
                <th>Severity</th>
                <th>Server</th>
                <th>Monitor</th>
                <th>Resource</th>
                <th>Message</th>
                <th>Count</th>
                <th>Last seen</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _filtered)
            {
                <tr class="row-@a.Severity @(a.Suppressed ? "suppressed" : "")">
                    <td class="key">@AlertLabels.KeyPreview(a.Key)</td>
                    <td><SeverityBadge Severity="@a.Severity" /></td>
                    <td>@a.Server</td>
                    <td>@a.Monitor</td>
                    <td>@a.Resource</td>
                    <td class="msg">@a.Message</td>
                    <td>@a.Count.ToString("0")</td>
                    <td>@(a.LastSeen?.ToLocalTime().ToString("MM-dd HH:mm") ?? "—")</td>
                    <td>
                        @if (a.Suppressed)
                        {
                            <button type="button" class="btn btn-small" @onclick="() => Unsuppress(a)">@AlertLabels.Action("Unsuppress", a, _filtered)</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-small btn-warn" @onclick="() => Suppress(a)">@AlertLabels.Action("Suppress", a, _filtered)</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_flash))
{
    <div class="flash" role="status">@_flash</div>
}

@code {
    private StateSnapshot? _snapshot;
    private List<AlertView> _filtered = new();
    private string _filter = "all";
    private string? _flash;

    private string Filter
    {
        get => _filter;
        set { _filter = string.IsNullOrEmpty(value) ? "all" : value; ApplyFilter(); }
    }

    protected override void OnInitialized() => Refresh();
    protected override void OnParametersSet() => ApplyFilter();

    private void Refresh()
    {
        _snapshot = State.Load();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_snapshot is null) return;
        _filtered = _filter switch
        {
            "unsuppressed" => _snapshot.CapturedErrors.Where(a => !a.Suppressed).ToList(),
            "suppressed"   => _snapshot.CapturedErrors.Where(a => a.Suppressed).ToList(),
            _              => _snapshot.CapturedErrors.ToList(),
        };
    }

    private void Suppress(AlertView alert)
    {
        var subject = AlertLabels.Subject(alert);
        if (State.Suppress(alert.Key)) { _flash = $"Suppressed {subject}"; Refresh(); }
        else _flash = $"Could not suppress {subject}. It is not in the current alerts or captures.";
    }

    private void Unsuppress(AlertView alert)
    {
        var subject = AlertLabels.Subject(alert);
        if (State.Unsuppress(alert.Key)) { _flash = $"Unsuppressed {subject}"; Refresh(); }
        else _flash = $"Could not unsuppress {subject}. It is not in the current alerts or captures.";
    }
}
