@page "/alerts"
@rendermode InteractiveServer
@inject StateService State
@implements IDisposable

<PageTitle>Alerts — Veeam VHC AWS</PageTitle>

<h1>Alerts</h1>
<p class="muted">Problems that are open right now. Suppress one you already know about to stop its notifications.</p>

<div class="toolbar">
    <label for="alerts-severity">Severity:
        <select id="alerts-severity" @bind="SeverityFilter">
            <option value="">All</option>
            <option value="error">Error</option>
            <option value="critical">Critical</option>
            <option value="warning">Warning</option>
            <option value="ok">OK</option>
        </select>
    </label>
    <label for="alerts-server">Server:
        <select id="alerts-server" @bind="ServerFilter">
            <option value="">All</option>
            @foreach (var server in _servers)
            {
                <option value="@server">@server</option>
            }
        </select>
    </label>
    <label for="alerts-search">Search:
        <input id="alerts-search" type="text" @bind="SearchFilter" @bind:event="oninput" placeholder="resource or message" />
    </label>
    <button type="button" class="btn" @onclick="Refresh">Refresh</button>
</div>

@if (_snapshot is null)
{
    <p>Loading…</p>
}
else if (_snapshot.ActiveFindings.Count == 0)
{
    <p class="empty">No alerts yet.</p>
}
else if (_filtered.Count == 0)
{
    <p class="empty">No alerts match the current filters.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Severity</th>
                <th>Server</th>
                <th>Monitor</th>
                <th>Resource</th>
                <th>Message</th>
                <th>Count</th>
                <th>Last seen</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _filtered)
            {
                <tr class="row-@a.Severity @(a.Suppressed ? "suppressed" : "")">
                    <td><SeverityBadge Severity="@a.Severity" /></td>
                    <td>@a.Server</td>
                    <td>@a.Monitor</td>
                    <td>@a.Resource</td>
                    <td class="msg">@a.Message</td>
                    <td>@a.Count.ToString("0")</td>
                    <td>@(a.LastSeen?.ToLocalTime().ToString("MM-dd HH:mm") ?? "—")</td>
                    <td>
                        @if (a.Suppressed)
                        {
                            <button type="button" class="btn btn-small" @onclick="() => Unsuppress(a)">@AlertLabels.Action("Unsuppress", a, _filtered)</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-small btn-warn" @onclick="() => Suppress(a)">@AlertLabels.Action("Suppress", a, _filtered)</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_flash))
{
    <div class="flash" role="status">@_flash</div>
}

@code {
    private StateSnapshot? _snapshot;
    private List<AlertView> _filtered = new();
    private List<string> _servers = new();
    private string _severityFilter = "";
    private string _serverFilter = "";
    private string _searchFilter = "";

    private string SeverityFilter
    {
        get => _severityFilter;
        set { _severityFilter = value ?? ""; ApplyFilters(); }
    }

    private string ServerFilter
    {
        get => _serverFilter;
        set { _serverFilter = value ?? ""; ApplyFilters(); }
    }

    private string SearchFilter
    {
        get => _searchFilter;
        set { _searchFilter = value ?? ""; ApplyFilters(); }
    }
    private string? _flash;
    private Timer? _autoRefresh;

    protected override void OnInitialized()
    {
        Refresh();
        _autoRefresh = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose() => _autoRefresh?.Dispose();

    private void Refresh()
    {
        _snapshot = State.Load();
        _servers = _snapshot.ActiveFindings
            .Concat(_snapshot.CapturedErrors)
            .Select(a => a.Server)
            .Where(s => !string.IsNullOrEmpty(s))
            .Distinct()
            .OrderBy(s => s)
            .ToList();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_snapshot is null) return;
        IEnumerable<AlertView> q = _snapshot.ActiveFindings;
        if (!string.IsNullOrEmpty(_severityFilter))
            q = q.Where(a => a.Severity == _severityFilter);
        if (!string.IsNullOrEmpty(_serverFilter))
            q = q.Where(a => a.Server == _serverFilter);
        if (!string.IsNullOrEmpty(_searchFilter))
        {
            var s = _searchFilter.ToLowerInvariant();
            q = q.Where(a => a.Resource.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || a.Message.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        _filtered = q.ToList();
    }

    protected override void OnParametersSet() => ApplyFilters();

    private void Suppress(AlertView alert)
    {
        var subject = AlertLabels.Subject(alert);
        if (State.Suppress(alert.Key))
        {
            _flash = $"Suppressed {subject}";
            Refresh();
        }
        else _flash = $"Could not suppress {subject}. It is not in the current alerts or captures.";
    }

    private void Unsuppress(AlertView alert)
    {
        var subject = AlertLabels.Subject(alert);
        if (State.Unsuppress(alert.Key))
        {
            _flash = $"Unsuppressed {subject}";
            Refresh();
        }
        else _flash = $"Could not unsuppress {subject}. It is not in the current alerts or captures.";
    }
}
